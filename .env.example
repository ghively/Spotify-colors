# Copy to .env and fill in.
# From https://developer.spotify.com/dashboard → your app → Settings.
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Must EXACTLY match one of the Redirect URIs registered in your Spotify app.
# For local dev use http://127.0.0.1:5173 (Spotify no longer allows localhost).
# For production use your deployed URL, e.g. https://colors.yourdomain.com
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173

# Optional: in-app update check (mostly for the sideloaded Android APK).
# Point at a JSON file served from your PWA host that looks like:
#   { "version": "0.2.0", "builtAt": "2026-05-20T12:00:00Z" }
# The PWA build automatically writes this file to dist/version.json.
VITE_UPDATE_CHECK_URL=https://colors.yourdomain.com/version.json

# Where the "Get it" button in the update banner sends the user — typically a
# GitHub Releases page or a direct APK download URL.
VITE_UPDATE_DOWNLOAD_URL=https://github.com/ghively/spotify-colors/releases/latest
