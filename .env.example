# Copy to .env and fill in.
# From https://developer.spotify.com/dashboard → your app → Settings.
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Must EXACTLY match one of the Redirect URIs registered in your Spotify app.
# For local dev use http://127.0.0.1:5173 (Spotify no longer allows localhost).
# For production use your deployed URL, e.g. https://colors.yourdomain.com
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173
